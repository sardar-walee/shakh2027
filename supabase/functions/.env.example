# Supabase usually provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# automatically to deployed Edge Functions. Never put this file's real values in Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_AS_EDGE_SECRET_ONLY

# Required by verify-car-listing-payment/index.ts.
PAYMENT_PROVIDER_VERIFY_URL=https://YOUR_PROVIDER.example.com/verify
PAYMENT_PROVIDER_SECRET=PASTE_PAYMENT_PROVIDER_SECRET_AS_EDGE_SECRET_ONLY